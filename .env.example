# --- Database (Neon in production, local Postgres in dev) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ratings_ghana?schema=public"

# --- Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Public URL of the app; used in email verification links.
AUTH_URL="http://localhost:3000"
# Optional: Google sign-in. Create an OAuth client at console.cloud.google.com
# with redirect URI {AUTH_URL}/api/auth/callback/google. The button is hidden when unset.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Email (Resend) ---
# Without a key in dev, verification links are written to .dev-outbox.log.
RESEND_API_KEY=""
EMAIL_FROM="RatingsGhana <noreply@your-domain.com>"

# --- SMS for phone verification ---
# "console" (dev only: codes go to .dev-outbox.log) or "arkesel" (production).
SMS_PROVIDER="console"
ARKESEL_API_KEY=""
ARKESEL_SENDER_ID="RatingsGH"

# --- Seeding ---
SEED_ADMIN_EMAIL="admin@ratingsghana.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
# Adds demo reviewers and reviews. Local development only — never in production.
SEED_DEMO_DATA="true"
